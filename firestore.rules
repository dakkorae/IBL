rules_version = '2';

// IB 학습자상 포트폴리오 – 학급 운영용 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 파일 내용을 그대로 붙여 넣고 '게시'합니다.
//
// 원칙
// - 모든 기기는 익명 로그인(개인정보 없음)으로 고유 ID(uid)만 가짐
// - 비밀번호(관리자 키·교사 비밀번호·학생 비밀번호)는 해시값만 저장하고, 그 문서는 누구도 읽을 수 없음
// - "비밀번호를 아는 기기"만 자기 uid로 등록 문서(admins / teachers / members)를 만들 수 있고,
//   그 등록 문서가 있어야 해당 권한으로 읽고 쓸 수 있음
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function isTeacher(cid) {
      return signedIn() && exists(/databases/$(db)/documents/classes/$(cid)/teachers/$(request.auth.uid));
    }
    function isMember(cid) {
      return signedIn() && exists(/databases/$(db)/documents/classes/$(cid)/members/$(request.auth.uid));
    }
    // 이 기기가 등록된 학생 번호(sid)
    function memberSid(cid) {
      return get(/databases/$(db)/documents/classes/$(cid)/members/$(request.auth.uid)).data.sid;
    }
    // 이 기기가 학급 cid의 학생 sid로 등록되어 있고, 그 뒤로 비밀번호가 초기화되지 않았는지
    function isStudent(cid, sid) {
      let member = get(/databases/$(db)/documents/classes/$(cid)/members/$(request.auth.uid));
      return signedIn()
        && member != null
        && member.data.sid == sid
        && member.data.pinHash == get(/databases/$(db)/documents/classes/$(cid)/pins/$(sid)).data.pinHash;
    }
    // 같은 묶음 쓰기(처음 입장)로 방금 등록되는 경우까지 포함
    function isStudentAfter(cid, sid) {
      let member = getAfter(/databases/$(db)/documents/classes/$(cid)/members/$(request.auth.uid));
      return signedIn()
        && member != null
        && member.data.sid == sid
        && member.data.pinHash == getAfter(/databases/$(db)/documents/classes/$(cid)/pins/$(sid)).data.pinHash;
    }

    // 학급 자료를 지울 수 있는 사람: 그 학급의 교사, 또는 관리자(개설 코드를 삭제하면서 그 코드로 만든 학급을 함께 지울 때)
    // - 관리자는 지우기와, 지울 문서를 찾는 데 필요한 목록(등록 기기·신고)만 볼 수 있고 학생 기록·게시글 내용은 읽지 못함
    function canWipe(cid) {
      return isTeacher(cid) || isAdmin();
    }
    // 교사 비밀번호 재설정이 올바른지 (secrets/teacher 를 바꿀 때)
    function validReset(cid) {
      let resetPath = /databases/$(db)/documents/classes/$(cid)/secrets/reset;
      let r = get(resetPath).data;
      return signedIn()
        && exists(resetPath)
        && request.resource.data.keys().hasOnly(['keyHash', 'resetHash'])
        && request.resource.data.keyHash is string
        && request.resource.data.resetHash == r.codeHash
        && request.time < r.expiresAt
        && resource.data.get('resetHash', '') != r.codeHash;
    }
    // 닉네임: 1~12글자
    function validNick(nick) {
      return nick is string && nick.size() >= 1 && nick.size() <= 12;
    }
    // 게시판(칭찬·나눔)에 학생이 글을 올릴 때: 자기 이름으로 된 글 하나만 더할 수 있음 (남의 글 수정·삭제 불가)
    // - 문서 모양: { posts: { 글ID: 글 }, last: 방금 넣은 글ID }
    function ownEntry(cid) {
      let pid = request.resource.data.last;
      let entry = request.resource.data.posts[pid];
      return isMember(cid)
        && pid is string
        && entry.id == pid
        && entry.from == memberSid(cid)
        && entry.text is string && entry.text.size() <= 300
        && entry.fromName is string && entry.fromName.size() <= 12
        && entry.get('toName', '') is string && entry.get('toName', '').size() <= 20;
    }
    function boardCreate(cid) {
      return ownEntry(cid)
        && request.resource.data.keys().hasOnly(['posts', 'last'])
        && request.resource.data.posts.keys().hasOnly([request.resource.data.last]);
    }
    function boardAdd(cid) {
      return ownEntry(cid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['posts', 'last'])
        && !(request.resource.data.last in resource.data.get('posts', {}))
        && request.resource.data.posts.diff(resource.data.get('posts', {})).affectedKeys().hasOnly([request.resource.data.last]);
    }

    // 좋아요: 이미 있는 글 하나에서 자기 좋아요만 켜거나 끌 수 있음
    // - 문서 모양: { likes: { 글ID: { 학생sid: true } }, liked: 방금 누른 글ID }
    function boardLike(cid) {
      let pid = request.resource.data.liked;
      let sid = memberSid(cid);
      let before = resource.data.get('likes', {});
      return isMember(cid)
        && pid is string
        && pid in resource.data.get('posts', {})
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'liked'])
        && request.resource.data.likes.diff(before).affectedKeys().hasOnly([pid])
        && request.resource.data.likes[pid].diff(before.get(pid, {})).affectedKeys().hasOnly([sid])
        && request.resource.data.likes[pid].get(sid, true) == true;
    }

    // 내 글 지우기: 자기가 쓴 글 하나와 그 글의 좋아요만 지울 수 있음
    // - 문서에 removed: 지운 글ID 를 함께 적음
    function boardRemove(cid) {
      let pid = request.resource.data.removed;
      let before = resource.data.get('posts', {});
      return isMember(cid)
        && pid is string
        && pid in before
        && before[pid].from == memberSid(cid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['posts', 'likes', 'removed'])
        && request.resource.data.posts.diff(before).removedKeys().hasOnly([pid])
        && request.resource.data.posts.diff(before).affectedKeys().hasOnly([pid])
        && request.resource.data.get('likes', {}).diff(resource.data.get('likes', {})).affectedKeys().hasOnly([pid])
        && !(pid in request.resource.data.get('likes', {}));
    }

    // ---------- 관리자 ----------
    // config/admin { keyHash } 는 콘솔에서 직접 한 번 만들어 둠. 앱에서는 읽지도 쓰지도 못함
    match /config/{docId} {
      allow read, write: if false;
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['keyHash'])
        && request.resource.data.keyHash == get(/databases/$(db)/documents/config/admin).data.keyHash;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- 개설 코드 ----------
    match /inviteCodes/{code} {
      allow get: if signedIn(); // 코드를 정확히 아는 사람만 조회 가능 (목록 조회는 관리자만)
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.active == true
            && resource.data.usedCount < resource.data.maxClasses
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
            && request.resource.data.usedCount == resource.data.usedCount + 1);
    }

    // ---------- 학급 ----------
    match /classes/{cid} {
      allow get: if signedIn(); // 학급 코드를 아는 사람만 조회 가능
      allow list: if isAdmin();
      // 개설: 유효한 개설 코드가 있어야 하고, 같은 묶음에서 그 코드의 사용 횟수를 1 올려야 함
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'inviteCode', 'createdAt', 'maxStudents'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.get('maxStudents', 100) is int
        && request.resource.data.get('maxStudents', 100) >= 1
        && request.resource.data.get('maxStudents', 100) <= 100
        && get(/databases/$(db)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.active == true
        && get(/databases/$(db)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.usedCount
           < get(/databases/$(db)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.maxClasses
        && getAfter(/databases/$(db)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.usedCount
           == get(/databases/$(db)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.usedCount + 1
        && existsAfter(/databases/$(db)/documents/classes/$(cid)/teachers/$(request.auth.uid));
      // 교사가 바꿀 수 있는 것: 학급 이름, 중점 학습자상(focus), 공동 목표(goal), 우리 반 미션(extraMissions), 지난 활동(log)
      allow update: if isTeacher(cid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'focus', 'goal', 'extraMissions', 'log'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if canWipe(cid);

      // 교사 비밀번호 해시: 학급을 만드는 묶음에서만 생성, 아무도 읽지 못함
      // secrets/teacher { keyHash, resetHash? } : 교사 비밀번호 해시 (resetHash: 마지막으로 쓴 재설정 코드 → 같은 코드 재사용 막기)
      // secrets/reset { codeHash, expiresAt } : 관리자가 발급한 비밀번호 재설정 코드의 해시와 만료 시각
      match /secrets/{docId} {
        allow read: if false;
        allow create: if signedIn() && docId == 'teacher'
          && !exists(/databases/$(db)/documents/classes/$(cid))
          && existsAfter(/databases/$(db)/documents/classes/$(cid));
        // 비밀번호 재설정: 관리자가 발급한 재설정 코드를 아는 사람만, 만료 전에, 한 번만 새 비밀번호로 바꿀 수 있음
        allow update: if docId == 'teacher' && validReset(cid);
        // 재설정 코드 발급(관리자만): 길어야 2일 안에 만료
        allow create, update: if docId == 'reset' && isAdmin()
          && exists(/databases/$(db)/documents/classes/$(cid))
          && request.resource.data.keys().hasOnly(['codeHash', 'expiresAt'])
          && request.resource.data.codeHash is string
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt <= request.time + duration.value(2, 'd');
        allow delete: if canWipe(cid);
      }
      // 교사로 등록된 기기: 교사 비밀번호 해시가 일치해야 만들 수 있음
      match /teachers/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if canWipe(cid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['keyHash'])
          && request.resource.data.keyHash
             == getAfter(/databases/$(db)/documents/classes/$(cid)/secrets/teacher).data.keyHash;
        allow delete: if canWipe(cid);
      }

      // 학생 명단 (자리 번호·닉네임만): 학급 코드를 아는 사람은 볼 수 있음
      match /students/{sid} {
        allow read: if signedIn();
        allow delete: if canWipe(cid);
        // 학생이 스스로 등록: 같은 묶음에서 비밀번호와 기기 등록을 함께 만들어야 하고,
        // 자리 번호는 1 ~ 학급 정원(maxStudents, 없으면 100) 안이어야 함
        allow create: if isTeacher(cid)
          || (isStudentAfter(cid, sid)
              && request.resource.data.keys().hasOnly(['number', 'nickname', 'claimed'])
              && request.resource.data.claimed == true
              && request.resource.data.number is int
              && request.resource.data.number >= 1
              && request.resource.data.number <= get(/databases/$(db)/documents/classes/$(cid)).data.get('maxStudents', 100)
              && sid == 's' + string(request.resource.data.number)
              && validNick(request.resource.data.nickname));
        allow update: if isTeacher(cid)
          // 비밀번호가 없는 자리(교사가 초기화했거나 예전 방식의 빈 자리)에 들어올 때
          || (isStudentAfter(cid, sid)
              && resource.data.claimed == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'nickname'])
              && request.resource.data.claimed == true
              && validNick(request.resource.data.nickname))
          // 본인이 닉네임 바꾸기: 30일에 한 번 (바꾼 때는 서버 시계로 기록)
          || (isStudent(cid, sid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'nickAt'])
              && validNick(request.resource.data.nickname)
              && request.resource.data.nickAt == request.time
              && (!('nickAt' in resource.data) || request.time > resource.data.nickAt + duration.value(30, 'd')));
      }
      // 학생 비밀번호 해시: 아직 없을 때 한 번만 만들 수 있고, 교사만 지울(초기화) 수 있음
      match /pins/{sid} {
        allow read, update: if false;
        allow create: if signedIn()
          && existsAfter(/databases/$(db)/documents/classes/$(cid)/students/$(sid))
          && request.resource.data.keys().hasOnly(['pinHash']);
        allow delete: if canWipe(cid);
      }
      // 학생으로 등록된 기기: 비밀번호 해시가 일치해야 만들 수 있음
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if canWipe(cid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['sid', 'pinHash'])
          && request.resource.data.pinHash
             == getAfter(/databases/$(db)/documents/classes/$(cid)/pins/$(request.resource.data.sid)).data.pinHash;
        allow delete: if (signedIn() && request.auth.uid == uid) || canWipe(cid);
      }
      // 학급 합계(학생들에게 보여 주는 우리 반 현황): 개인별 수치 없이 합계만 담음
      // 학급에 참여한 기기와 교사가 읽고 씀. 교사 화면을 열 때마다 전체 기록으로 다시 계산해 바로잡음
      match /public/stats {
        allow get, create, update: if isTeacher(cid) || isMember(cid);
        allow delete: if canWipe(cid);
      }
      // 나눔 게시판 · 칭찬 게시판: 학급에 참여한 기기가 읽고, 자기 글 하나씩만 더하거나 지우고, 좋아요를 누를 수 있음. 남의 글 내리기는 교사만
      match /public/board {
        allow get: if isTeacher(cid) || isMember(cid);
        allow create: if isTeacher(cid) || boardCreate(cid);
        allow update: if isTeacher(cid) || boardAdd(cid) || boardLike(cid) || boardRemove(cid);
        allow delete: if canWipe(cid);
      }
      match /public/praise {
        allow get: if isTeacher(cid) || isMember(cid);
        allow create: if isTeacher(cid) || boardCreate(cid);
        allow update: if isTeacher(cid) || boardAdd(cid) || boardLike(cid) || boardRemove(cid);
        allow delete: if canWipe(cid);
      }
      // (예전 방식) 승인 대기함과 쪽지함: 이제 쓰지 않음. 남아 있는 자료는 교사만 읽고 지울 수 있음
      match /inbox/{sid} {
        allow read: if isTeacher(cid);
        allow delete: if canWipe(cid);
      }
      match /posts/{pid} {
        allow read, delete: if canWipe(cid);
      }
      // 공감 스티커: 누른 본인, 그 글의 글쓴이, 교사만 읽음 (다른 학생은 개수를 알 수 없음)
      match /reactions/{rid} {
        allow read: if canWipe(cid)
          || (isMember(cid) && (resource.data.sid == memberSid(cid) || resource.data.author == memberSid(cid)));
        allow create, update: if isMember(cid)
          && request.resource.data.sid == memberSid(cid)
          && rid == request.resource.data.postId + '_' + request.resource.data.sid;
        allow delete: if canWipe(cid) || (isMember(cid) && resource.data.sid == memberSid(cid));
      }
      // 불편한 글 알리기: 학생이 만들고 교사만 읽음
      match /reports/{rid} {
        allow create, update: if isMember(cid) && request.resource.data.sid == memberSid(cid);
        allow read, delete: if canWipe(cid);
      }
      // 교사 피드백: 교사가 쓰고, 해당 학생 본인만 읽음
      match /feedback/{sid} {
        allow get: if isTeacher(cid) || isStudent(cid, sid);
        allow list, create, update: if isTeacher(cid);
        allow delete: if canWipe(cid);
      }
      // 학생별 실천 기록: 본인과 교사만 읽고, 본인만 씀
      match /portfolios/{sid} {
        allow get: if isTeacher(cid) || isStudent(cid, sid);
        allow list: if isTeacher(cid);
        allow create, update: if isStudent(cid, sid);
        allow delete: if canWipe(cid);
      }
    }
  }
}
